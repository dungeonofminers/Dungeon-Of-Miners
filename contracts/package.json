{
  "name": "dom-staking-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "DomStaking smart contract (fixed-term DOM staking on BNB Smart Chain)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "export-abi": "node scripts/export-abi.cjs",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.cjs --network bsc",
    "verify:testnet": "hardhat run scripts/verify-bscscan.cjs --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify-bscscan.cjs --network bsc",
    "update-aprs:mainnet": "hardhat run scripts/update-aprs.cjs --network bsc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6"
  }
}
