# Copy to .env.deploy (gitignored) and fill in WITH AN EDITOR.
# Never paste the private key into a terminal command, chat, or commit.

DEPLOY_PRIVATE_KEY=

# Optional custom RPCs (https)
RPC_TESTNET_URL=
RPC_MAINNET_URL=

# Testnet tDOM: 0xEb256a0F0d028a3EA698624e47Ed94f9Ce8c06EF
# Mainnet DOM:  0xB33A511B88b6691bE265DdBCD0c8dbE6A4fCf515
STAKING_TOKEN_ADDRESS=

# Staking Reward Safe (mainnet): 0x10ADfD32f15778a9F2CA09662e34074D79F3C62B
STAKING_OWNER_ADDRESS=

# Whole DOM units
STAKING_MIN_STAKE=100
STAKING_MAX_STAKE=5000000

# Optional — Etherscan API v2 key (works for BscScan mainnet & testnet) for automated verification
ETHERSCAN_API_KEY=
