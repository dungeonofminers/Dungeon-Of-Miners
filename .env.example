# WalletConnect project ID — required for the WalletConnect connector on the
# Staking page. Create one at https://cloud.walletconnect.com/
# Without it, only the injected browser wallet (MetaMask) is available.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed DomStaking contract address on BNB Smart Chain.
# Leave empty until the contract is deployed and funded — the /staking page
# will display the published tiers and preview calculator in "Coming Soon" mode.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=

# Chain ID for staking: 56 = BSC mainnet (default), 97 = BSC testnet (rehearsals).
NEXT_PUBLIC_STAKING_CHAIN_ID=56
